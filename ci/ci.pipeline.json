{
  "$schema": "../schemas/pipeline.authoring.schema.json",
  "extends": "./base.pipeline.json",
  "jobs": {
    "actionlint": {
      "description": "Validates the emitted workflow with GitHub's own linter rules.",
      "name": "Actionlint",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "run",
          "name": "Install actionlint",
          "run": "go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12"
        },
        {
          "kind": "run",
          "name": "Lint workflows",
          "run": "\"$(go env GOPATH)/bin/actionlint\""
        }
      ],
      "timeoutMinutes": 10
    },
    "drift": {
      "description": "Fails when a generated file differs from what the tool emits now.",
      "name": "Generated files",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "pnpm/action-setup@v6"
          },
          "provider": "github-actions"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "actions/setup-node@v7",
            "with": {
              "cache": "pnpm",
              "node-version-file": ".tool-versions"
            }
          },
          "provider": "github-actions"
        },
        {
          "form": "native",
          "kind": "run",
          "name": "Install",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "kind": "run",
          "name": "Generated files",
          "run": "node packages/cli/src/bin.ts check --pipeline ci/ci.pipeline.json --provider github-actions --tool-command \"node packages/cli/src/bin.ts\" && node packages/cli/src/bin.ts schema | diff -u schemas/pipeline.schema.json - && node packages/cli/src/bin.ts schema --authoring | diff -u schemas/pipeline.authoring.schema.json -"
        }
      ],
      "timeoutMinutes": 15
    },
    "lint": {
      "description": "ESLint over the whole workspace, with no warnings allowed.",
      "name": "Lint",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "pnpm/action-setup@v6"
          },
          "provider": "github-actions"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "actions/setup-node@v7",
            "with": {
              "cache": "pnpm",
              "node-version-file": ".tool-versions"
            }
          },
          "provider": "github-actions"
        },
        {
          "form": "native",
          "kind": "run",
          "name": "Install",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "kind": "run",
          "name": "Lint",
          "run": "pnpm run lint"
        }
      ],
      "timeoutMinutes": 15
    },
    "platform-smoke": {
      "description": "Reads this very run back through the platform adapter with the workflow token, so the live read path is exercised on every run. A required-check comparison is not possible here: rulesets are unavailable to a private repository on this organisation's plan, and the API answers 403.",
      "name": "Platform read path",
      "native": {
        "github-actions": {
          "env": {
            "COMMIT": "${{ github.event.pull_request.head.sha || github.sha }}",
            "GH_TOKEN": "${{ github.token }}",
            "REPOSITORY": "${{ github.repository }}",
            "RUN_ID": "${{ github.run_id }}"
          }
        }
      },
      "permissions": {
        "actions": "read",
        "checks": "read",
        "contents": "read"
      },
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "pnpm/action-setup@v6"
          },
          "provider": "github-actions"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "actions/setup-node@v7",
            "with": {
              "cache": "pnpm",
              "node-version-file": ".tool-versions"
            }
          },
          "provider": "github-actions"
        },
        {
          "form": "native",
          "kind": "run",
          "name": "Install",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "kind": "run",
          "name": "Read this run",
          "run": "node packages/cli/src/bin.ts platform run --repo \"$REPOSITORY\" --run \"$RUN_ID\" | grep -F running"
        },
        {
          "kind": "run",
          "name": "List this commit's checks",
          "run": "node packages/cli/src/bin.ts platform checks --sha \"$COMMIT\""
        }
      ],
      "timeoutMinutes": 10
    },
    "required-checks": {
      "description": "The single branch-protection target. It runs whatever the other jobs concluded and fails unless all succeeded.",
      "name": "Required checks",
      "needs": [
        "lint",
        "typecheck",
        "test",
        "drift",
        "actionlint",
        "platform-smoke"
      ],
      "needsPolicy": "always",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "provider",
          "native": {
            "if": "contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') || contains(needs.*.result, 'skipped')",
            "name": "Fail when a required job did not succeed",
            "run": "exit 1"
          },
          "provider": "github-actions"
        },
        {
          "kind": "run",
          "name": "Report",
          "run": "echo all required jobs succeeded"
        }
      ],
      "timeoutMinutes": 5
    },
    "test": {
      "description": "Unit tests, including each adapter's conformance kit. Rendered in the wrapper form, so this job runs through the tool's own runner.",
      "form": "wrapper",
      "name": "Test",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "pnpm/action-setup@v6"
          },
          "provider": "github-actions"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "actions/setup-node@v7",
            "with": {
              "cache": "pnpm",
              "node-version-file": ".tool-versions"
            }
          },
          "provider": "github-actions"
        },
        {
          "form": "native",
          "kind": "run",
          "name": "Install",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "kind": "run",
          "name": "Test",
          "run": "pnpm run test"
        }
      ],
      "timeoutMinutes": 15
    },
    "typecheck": {
      "description": "One TypeScript program for every package.",
      "name": "Typecheck",
      "runsOn": [
        {
          "$param": "runner"
        }
      ],
      "steps": [
        {
          "kind": "checkout"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "pnpm/action-setup@v6"
          },
          "provider": "github-actions"
        },
        {
          "kind": "provider",
          "native": {
            "uses": "actions/setup-node@v7",
            "with": {
              "cache": "pnpm",
              "node-version-file": ".tool-versions"
            }
          },
          "provider": "github-actions"
        },
        {
          "form": "native",
          "kind": "run",
          "name": "Install",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "kind": "run",
          "name": "Typecheck",
          "run": "pnpm run typecheck"
        }
      ],
      "timeoutMinutes": 15
    }
  },
  "parameters": {
    "runner": {
      "default": "ubuntu-latest",
      "description": "Runner label every job runs on.",
      "type": "string"
    }
  }
}
