{
  "name": "ci-adapters",
  "private": true,
  "description": "Workspace root. Never published: it holds the workspace, the shared tooling configuration and the repository's own self-hosted pipeline definition.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/ci-adapters.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "ci:emit": "node packages/cli/src/bin.ts emit --pipeline ci/pipeline.ts --provider github-actions --out .github/workflows/ci.yml",
    "ci:check": "node packages/cli/src/bin.ts check --pipeline ci/pipeline.ts --provider github-actions --out .github/workflows/ci.yml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@exadev/eslint-config": "2.36.4",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
